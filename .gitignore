# 测试 fixtures：含真合同，gitignore 内容（.gitkeep 保留）
test-fixtures/*
!test-fixtures/.gitkeep

# scripts/__fixtures__：probe fixture 已删，保留 .gitkeep 防 git 报空目录
# scripts/__tests__/ 不屏蔽（check-pii.test.ts 是通用测试代码，必须 push）
scripts/__fixtures__/*
!scripts/__fixtures__/.gitkeep

# pii-clean.sh / filter-branch 的物理备份目录 —— 内含【清理前】的 git history（含真 PII）。
# 绝不能被 git add -A 意外提交回仓库。
.git.bak.*
