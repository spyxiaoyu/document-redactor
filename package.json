{
  "name": "document-redactor",
  "private": true,
  "version": "1.0.0",
  "description": "100% client-side document desensitization tool (DOCX/PDF/Excel/Image OCR/TXT/MD) with reversible masking. Files never leave your browser.",
  "type": "module",
  "license": "MIT",
  "author": "spy",
  "homepage": "https://github.com/spyxiaoyu/document-redactor#readme",
  "bugs": {
    "url": "https://github.com/spyxiaoyu/document-redactor/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spyxiaoyu/document-redactor.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 10",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check:pii": "bash scripts/check-pii.sh"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dexie": "^3.2.4",
    "docx": "^8.5.0",
    "dompurify": "^3.0.8",
    "lucide-react": "^0.344.0",
    "mammoth": "^1.6.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.1",
    "tesseract.js": "^5.0.4",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "puppeteer-core": "^25.4.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
